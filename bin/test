#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the suite: bin/test [test/file_test.rb ...] [-n /pattern/]
$LOAD_PATH.unshift File.expand_path("../lib", __dir__), File.expand_path("../test", __dir__)
files = ARGV.take_while { |a| !a.start_with?("-") }
ARGV.shift(files.size)
(files.empty? ? Dir[File.expand_path("../test/**/*_test.rb", __dir__)] : files).sort.each { |f| require File.expand_path(f) }
